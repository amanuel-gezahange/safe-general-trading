# Copy to .env.local for local development.
# In production, set these in Netlify → Site configuration → Environment variables.

# AI chat assistant (Groq, OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Rate limiting for chat and quote form (required — requests are refused without it)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Quote form email delivery (Resend)
RESEND_API_KEY=
QUOTE_FROM_EMAIL=quotes@your-verified-domain.com
QUOTE_TO_EMAIL=sanoymekonnen85@gmail.com
