// Regenerates the logo image assets from lib/logo-svg.ts.
// Run from the project root:  node scripts/build-logo.mts
import { writeFileSync } from "node:fs";
import sharp from "sharp";
import { markSvg, lockupSvg } from "../lib/logo-svg.ts";

// Browser tab icon.
writeFileSync("app/icon.svg", markSvg());

// Apple home-screen icon: mark on a white tile.
const tile = await sharp(Buffer.from(markSvg()), { density: 300 }).resize(140, 140).png().toBuffer();
await sharp({ create: { width: 180, height: 180, channels: 4, background: "#ffffff" } })
  .composite([{ input: tile, left: 20, top: 20 }])
  .png()
  .toFile("app/apple-icon.png");

// Full logo for next/og share images, which cannot draw these SVG paths reliably.
const lockup = await sharp(Buffer.from(lockupSvg()), { density: 300 }).resize({ height: 160 }).png().toBuffer();
const { width, height } = await sharp(lockup).metadata();
writeFileSync(
  "lib/logo-png.ts",
  `// Generated by scripts/build-logo.mts. Full SGT logo as PNG for next/og share images.\n` +
    `export const LOGO_PNG = { width: ${width}, height: ${height}, src: "data:image/png;base64,${lockup.toString("base64")}" };\n`
);

console.log("Logo assets written.");
